{
    "venvPath": ".",
    "venv": ".venv",
    "executionEnvironments": [
        {
            "root": "src",
            "extraPaths": ["."]
        },
        {
            "root": "template",
            "extraPaths": ["src"]
        }
    ],
    "include": [
        "src",
        "template"
    ],
    "typeCheckingMode": "strict",
    "useLibraryCodeForTypes": true
}
